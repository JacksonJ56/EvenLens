RSSHUB_BASE_URL=http://127.0.0.1:1200
BOARD_REFRESH_SECONDS=300
BOARD_REQUEST_TIMEOUT_SECONDS=15
BOARD_ROUTES_FILE=boards.json

# DeepSeek Search / Fetch and the independent OpenAI-compatible model
DEEPSEEK_API_KEY=
DEEPSEEK_SEARCH_MAX_RESULTS=10
EVENT_TRACE_LLM_API_KEY=
EVENT_TRACE_LLM_BASE_URL=https://api.deepseek.com/v1
EVENT_TRACE_LLM_MODEL=DeepSeek-V4.1-Flash-1017
EVENT_TRACE_MAX_ROUNDS=3
EVENT_TRACE_MAX_QUERIES=3
EVENT_TRACE_MAX_FETCH=9
EVENT_TRACE_PARALLEL=3
EVENT_TRACE_CALL_TIMEOUT_SECONDS=18
EVENT_TRACE_TIMEOUT_SECONDS=100

# Public Opinion Intelligence (same LLM configuration as event tracing above)
# Local default: SQLite. PostgreSQL: postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/eventlens
# PUBLIC_OPINION_DATABASE_URL=sqlite:////absolute/path/to/public_opinion.sqlite3
PUBLIC_OPINION_MAX_POSTS=20
PUBLIC_OPINION_COMMENTS_PER_POST=50
PUBLIC_OPINION_MAX_COMMENTS=1000
PUBLIC_OPINION_MAX_REPLIES=100
PUBLIC_OPINION_DISCOVERY_SEARCHES=5
PUBLIC_OPINION_DISCOVERY_FETCHES=15
PUBLIC_OPINION_CONTEXT_SEARCHES=3
PUBLIC_OPINION_CONTEXT_TIMEOUT=60
PUBLIC_OPINION_CONTEXT_TOKEN_BUDGET=40000
PUBLIC_OPINION_DISCOVERY_TIMEOUT=90
PUBLIC_OPINION_TASK_TIMEOUT=600
PUBLIC_OPINION_COLLECTOR_TIMEOUT=60
PUBLIC_OPINION_MODEL_CALLS=60
PUBLIC_OPINION_TOKEN_BUDGET=120000
PUBLIC_OPINION_BATCH_BYTES=10000
PUBLIC_OPINION_COMMENT_CHARS=1200
PUBLIC_OPINION_MODEL_OUTPUT_TOKENS=2500
PUBLIC_OPINION_TOOL_TIMEOUT=180
# Independent MediaCrawler checkout/interpreter. Leave authorization false until applicable.
MEDIACRAWLER_HOME=
MEDIACRAWLER_PYTHON=python
MEDIACRAWLER_AUTHORIZED=false
MEDIACRAWLER_COOKIES_XHS=
MEDIACRAWLER_COOKIES_DY=
MEDIACRAWLER_COOKIES_KS=
MEDIACRAWLER_COOKIES_BILI=
MEDIACRAWLER_COOKIES_WB=
MEDIACRAWLER_COOKIES_TIEBA=
MEDIACRAWLER_COOKIES_ZHIHU=

# Optional: independently verify real public DNS only for local 198.18/15 Fake-IP proxies.
PUBLIC_OPINION_PUBLIC_DNS_FALLBACK=false
