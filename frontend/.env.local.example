EVENTLENS_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_TRENDING_MODE=live

# Server-only: shared backend settings are read from ../backend/.env by default.
# EVENTLENS_BACKEND_ENV_FILE=/absolute/path/to/EventLens/backend/.env
# COPILOT_SECURE_COOKIE=true  # only when serving the local app over HTTPS
# For a private CA, set NODE_EXTRA_CA_CERTS in the shell BEFORE starting Node.
# See ../COPILOT.md. Do not disable TLS certificate verification.
